<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- آیکون و عنوان -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📞"
            android:textSize="64sp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="پل تماس"
            android:textSize="28sp"
            android:textColor="#212121"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اتصال کامپیوتر به گوشی بدون ADB"
            android:textSize="13sp"
            android:textColor="#757575"
            android:layout_marginBottom="32dp"/>

        <!-- وضعیت -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔴 سرویس متوقف است"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/ipText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#424242"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="monospace"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- دکمه شروع/توقف -->
        <Button
            android:id="@+id/startBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶️  شروع سرویس"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="24dp"/>

        <!-- راهنما -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 راهنما:\n\n۱. دکمه «شروع سرویس» را بزنید\n۲. دسترسی‌ها را تأیید کنید\n۳. از کامپیوتر به آدرس نمایش‌داده‌شده وصل شوید\n\n🔌 برای اتصال با کابل:\nاتصال با کابل (USB Tethering) را در تنظیمات گوشی فعال کنید"
            android:textSize="13sp"
            android:textColor="#616161"
            android:lineSpacingExtra="6dp"
            android:background="#EEEEEE"
            android:padding="16dp"/>

        <!-- نکته -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️ اپ باید باز بماند تا کامپیوتر وصل شود"
            android:textSize="11sp"
            android:textColor="#9E9E9E"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>